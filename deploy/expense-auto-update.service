[Unit]
Description=Update expense_app_web from git and rebuild Docker image
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Adjust User/WorkingDirectory/key path if your checkout or SSH key differs.
User=rpi
Group=rpi
SupplementaryGroups=docker
WorkingDirectory=/home/rpi/Dokumente/Projekte/expense_app_web
Environment=HOME=/home/rpi
Environment=EXPENSE_APP_DIR=/home/rpi/Dokumente/Projekte/expense_app_web
Environment=EXPENSE_GIT_BRANCH=main
# systemd has no ssh-agent; point git at the deploy key explicitly.
# Change id_ed25519 to id_rsa if that is the key registered with GitHub.
Environment=GIT_SSH_COMMAND=/usr/bin/ssh -i /home/rpi/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new
ExecStart=/bin/bash /home/rpi/Dokumente/Projekte/expense_app_web/scripts/auto-update.sh
Nice=10
